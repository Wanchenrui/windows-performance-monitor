{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.perfmonitor.local/v1/update-manifest-v1.schema.json",
  "title": "PerfMonitor signed update manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "product",
    "channel",
    "version",
    "publishedAtUtc",
    "gitCommit",
    "databaseSchemaVersion",
    "support",
    "installer",
    "sbom",
    "signer"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "product": {"const": "PerfMonitor"},
    "channel": {"enum": ["test", "stable"]},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publishedAtUtc": {"type": "string", "format": "date-time"},
    "gitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "databaseSchemaVersion": {"type": "integer", "minimum": 1},
    "support": {
      "type": "object",
      "required": ["architecture", "operatingSystems"],
      "properties": {
        "architecture": {"const": "x64"},
        "operatingSystems": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "installer": {"$ref": "#/$defs/artifact"},
    "sbom": {"$ref": "#/$defs/artifact"},
    "signer": {
      "type": "object",
      "required": [
        "mode",
        "subject",
        "certificateSha256"
      ],
      "properties": {
        "mode": {"enum": ["test", "production"]},
        "subject": {"type": "string", "minLength": 1},
        "certificateSha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["url", "sha256", "sizeBytes"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9A-F]{64}$"
        },
        "sizeBytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
