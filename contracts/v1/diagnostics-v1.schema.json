{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.perfmonitor.local/v1/diagnostics-v1.schema.json",
  "title": "PerfMonitor Diagnostics Contract v1",
  "type": "object",
  "required": [
    "contractVersion",
    "productVersion",
    "instanceId",
    "query",
    "eventCount",
    "truncated",
    "events"
  ],
  "properties": {
    "contractVersion": {"const": "1.0"},
    "productVersion": {"type": "string", "minLength": 1},
    "instanceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "query": {
      "type": "object",
      "required": ["ruleIds", "states", "fromEpochMs", "toEpochMs", "maxEvents"],
      "properties": {
        "ruleIds": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "states": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["active", "resolved"]}
        },
        "fromEpochMs": {"type": "integer"},
        "toEpochMs": {"type": "integer"},
        "maxEvents": {"type": "integer", "minimum": 1, "maximum": 2000}
      },
      "additionalProperties": true
    },
    "eventCount": {"type": "integer", "minimum": 0, "maximum": 2000},
    "truncated": {"type": "boolean"},
    "events": {
      "type": "array",
      "maxItems": 2000,
      "items": {"$ref": "#/$defs/diagnosticEvent"}
    }
  },
  "$defs": {
    "diagnosticEvent": {
      "type": "object",
      "required": [
        "contractVersion",
        "productVersion",
        "eventId",
        "instanceId",
        "ruleId",
        "ruleVersion",
        "severity",
        "state",
        "subjectId",
        "hysteresis",
        "debounce",
        "cooldownSeconds",
        "evidenceWindow",
        "firstSeenUtc",
        "lastSeenUtc",
        "confidence",
        "evidence"
      ],
      "properties": {
        "contractVersion": {"const": "1.0"},
        "productVersion": {"type": "string", "minLength": 1},
        "eventId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "instanceId": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "ruleId": {"type": "string", "minLength": 1},
        "ruleVersion": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "critical"]},
        "state": {"enum": ["active", "resolved"]},
        "subjectId": {"type": "string", "minLength": 1},
        "hysteresis": {
          "type": "object",
          "required": ["activateWhen", "recoverWhen"],
          "properties": {
            "activateWhen": {"type": "string", "minLength": 1},
            "recoverWhen": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        },
        "debounce": {
          "type": "object",
          "required": ["activateSeconds", "recoverSeconds"],
          "properties": {
            "activateSeconds": {"type": "number", "minimum": 0},
            "recoverSeconds": {"type": "number", "minimum": 0}
          },
          "additionalProperties": true
        },
        "cooldownSeconds": {"type": "number", "minimum": 0},
        "evidenceWindow": {
          "type": "object",
          "required": ["fromUtc", "toUtc", "sampleCount"],
          "properties": {
            "fromUtc": {"type": "string", "format": "date-time"},
            "toUtc": {"type": "string", "format": "date-time"},
            "sampleCount": {"type": "integer", "minimum": 1, "maximum": 256}
          },
          "additionalProperties": true
        },
        "firstSeenUtc": {"type": "string", "format": "date-time"},
        "lastSeenUtc": {"type": "string", "format": "date-time"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["observedAtUtc", "subjectId", "signal", "condition"],
            "properties": {
              "observedAtUtc": {"type": "string", "format": "date-time"},
              "subjectId": {"type": "string", "minLength": 1},
              "signal": {"type": "string", "minLength": 1},
              "value": {"type": ["number", "null"]},
              "unit": {"type": ["string", "null"]},
              "condition": {
                "enum": ["breach", "recovery", "hysteresis_band"]
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
