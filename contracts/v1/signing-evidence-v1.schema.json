{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.perfmonitor.local/v1/signing-evidence-v1.schema.json",
  "title": "PerfMonitor Authenticode signing evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signatureMode",
    "subject",
    "issuer",
    "certificateSha1",
    "certificateSha256",
    "timestampUrl",
    "signedAtUtc",
    "files"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "signatureMode": {
      "enum": ["test", "production"]
    },
    "subject": {"type": "string", "minLength": 1},
    "issuer": {"type": "string", "minLength": 1},
    "certificateSha1": {
      "type": "string",
      "pattern": "^[0-9A-F]{40}$"
    },
    "certificateSha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "timestampUrl": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      ]
    },
    "signedAtUtc": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9A-F]{64}$"
          },
          "sizeBytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "signatureMode": {"const": "production"}
        },
        "required": ["signatureMode"]
      },
      "then": {
        "properties": {
          "timestampUrl": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          }
        }
      },
      "else": {
        "properties": {
          "timestampUrl": {"type": "null"}
        }
      }
    }
  ]
}
